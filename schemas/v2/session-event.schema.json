{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hve-forge:schema:v2:session-event",
  "title": "HVE-Forge Session Event Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "sequence",
    "eventType",
    "occurredAt",
    "payload",
    "previousHash",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventType": {
      "enum": [
        "session.created",
        "turn.requested",
        "turn.completed",
        "tool.call_dispatched",
        "tool.call_completed",
        "verification.recorded",
        "evaluation.recorded",
        "loop.stopped",
        "session.completed",
        "session.blocked",
        "session.failed",
        "session.cancelled"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "previousHash": { "$ref": "#/$defs/sha256" },
    "eventHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "session.created" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionCreatedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "turn.requested" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/turnRequestedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "turn.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/turnCompletedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "tool.call_dispatched" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/toolCallDispatchedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "tool.call_completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/toolCallCompletedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "verification.recorded" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/verificationPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "evaluation.recorded" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/evaluationPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "loop.stopped" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/loopStoppedPayload" } } }
    },
    {
      "if": {
        "properties": {
          "eventType": { "enum": ["session.blocked", "session.failed", "session.cancelled"] }
        }
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/terminalReasonPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "session.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/sessionCompletedPayload" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "toolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "sessionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTurns",
        "maxToolDispatches",
        "maxElapsedMilliseconds",
        "maxOutputTokensPerTurn",
        "maxTotalOutputTokens",
        "maxTotalCostMinorUnits",
        "repeatedSignatureThreshold",
        "oscillationWindow",
        "maxConsecutiveFailedFixes"
      ],
      "properties": {
        "maxTurns": { "type": "integer", "minimum": 1 },
        "maxToolDispatches": { "type": "integer", "minimum": 0 },
        "maxElapsedMilliseconds": { "type": "integer", "minimum": 1 },
        "maxOutputTokensPerTurn": { "type": "integer", "minimum": 1 },
        "maxTotalOutputTokens": { "type": "integer", "minimum": 1 },
        "maxTotalCostMinorUnits": { "type": "integer", "minimum": 0 },
        "repeatedSignatureThreshold": { "type": "integer", "minimum": 1 },
        "oscillationWindow": { "type": "integer", "minimum": 1 },
        "maxConsecutiveFailedFixes": { "type": "integer", "minimum": 1 }
      }
    },
    "sessionAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptVersion",
        "promptHash",
        "skillHashes",
        "evaluatorRubricVersion",
        "evaluatorRubricHash",
        "toolSchemaVersion",
        "providerAdapterVersion",
        "sandboxProfile"
      ],
      "properties": {
        "promptVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "promptHash": { "$ref": "#/$defs/sha256" },
        "skillHashes": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/sha256" } },
        "evaluatorRubricVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evaluatorRubricHash": { "$ref": "#/$defs/sha256" },
        "toolSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "providerAdapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sandboxProfile": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sessionCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "descriptorHash",
        "parentSessionId",
        "sourceFixtureHash",
        "policyVersion",
        "policyHash",
        "workContractHash",
        "limits",
        "assets"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "descriptorHash": { "$ref": "#/$defs/sha256" },
        "parentSessionId": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "sourceFixtureHash": { "$ref": "#/$defs/sha256" },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyHash": { "$ref": "#/$defs/sha256" },
        "workContractHash": { "$ref": "#/$defs/sha256" },
        "limits": { "$ref": "#/$defs/sessionLimits" },
        "assets": { "$ref": "#/$defs/sessionAssets" }
      }
    },
    "turnRequestedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnNumber", "requestHash"],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "requestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "turnCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnNumber",
        "requestHash",
        "responseHash",
        "actionSignature",
        "finishReason",
        "toolCallCount",
        "inputTokens",
        "outputTokens",
        "cachedTokens",
        "reasoningTokens",
        "costMode",
        "costMinorUnits"
      ],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "requestHash": { "$ref": "#/$defs/sha256" },
        "responseHash": { "$ref": "#/$defs/sha256" },
        "actionSignature": { "$ref": "#/$defs/sha256" },
        "finishReason": {
          "enum": ["completed", "tool_calls", "length", "cancelled", "content_filter", "error"]
        },
        "toolCallCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cachedTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "costMode": { "enum": ["host_managed", "metered"] },
        "costMinorUnits": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },
    "toolCallDispatchedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnNumber",
        "callIndex",
        "callId",
        "toolId",
        "idempotencyKey",
        "workspaceHashBefore"
      ],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "callIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "callId": { "$ref": "#/$defs/identifier" },
        "toolId": { "$ref": "#/$defs/toolId" },
        "idempotencyKey": { "$ref": "#/$defs/identifier" },
        "workspaceHashBefore": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolCallCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnNumber",
        "callIndex",
        "callId",
        "idempotencyKey",
        "outcome",
        "errorCode",
        "beforeFileHash",
        "afterFileHash",
        "outputHash",
        "workspaceHashAfter"
      ],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "callIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "callId": { "$ref": "#/$defs/identifier" },
        "idempotencyKey": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
        "errorCode": {
          "anyOf": [{ "type": "string", "minLength": 0, "maxLength": 128 }, { "type": "null" }]
        },
        "beforeFileHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "afterFileHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "outputHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "workspaceHashAfter": { "$ref": "#/$defs/sha256" }
      }
    },
    "verificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnNumber",
        "attemptNumber",
        "evidenceId",
        "resultHash",
        "artifactHash",
        "workspaceHash",
        "discoveredChecks",
        "passedChecks"
      ],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "resultHash": { "$ref": "#/$defs/sha256" },
        "artifactHash": { "$ref": "#/$defs/sha256" },
        "workspaceHash": { "$ref": "#/$defs/sha256" },
        "discoveredChecks": { "type": "integer", "minimum": 1 },
        "passedChecks": { "type": "integer", "minimum": 0 }
      }
    },
    "evaluationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "verdict",
        "artifactHash",
        "projectionHash",
        "workspaceHash",
        "eventChainHead",
        "evidenceHashes"
      ],
      "properties": {
        "evaluationId": { "$ref": "#/$defs/identifier" },
        "verdict": { "enum": ["approved", "changes_requested", "blocked"] },
        "artifactHash": { "$ref": "#/$defs/sha256" },
        "projectionHash": { "$ref": "#/$defs/sha256" },
        "workspaceHash": { "$ref": "#/$defs/sha256" },
        "eventChainHead": { "$ref": "#/$defs/sha256" },
        "evidenceHashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "loopStoppedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "turnsUsed", "toolDispatchesUsed"],
      "properties": {
        "reason": {
          "enum": [
            "provider_completed",
            "decision_budget_exhausted",
            "wall_clock_exhausted",
            "oscillation_detected",
            "failed_fix_exhausted",
            "cancelled"
          ]
        },
        "turnsUsed": { "type": "integer", "minimum": 0 },
        "toolDispatchesUsed": { "type": "integer", "minimum": 0 }
      }
    },
    "terminalReasonPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 1024 } }
    },
    "sessionCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionHash",
        "workspaceHash",
        "evaluationId",
        "evaluationEventHash",
        "evaluationArtifactHash",
        "verificationResultHash"
      ],
      "properties": {
        "projectionHash": { "$ref": "#/$defs/sha256" },
        "workspaceHash": { "$ref": "#/$defs/sha256" },
        "evaluationId": { "$ref": "#/$defs/identifier" },
        "evaluationEventHash": { "$ref": "#/$defs/sha256" },
        "evaluationArtifactHash": { "$ref": "#/$defs/sha256" },
        "verificationResultHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
