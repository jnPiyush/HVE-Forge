{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hve-forge:schema:v1:work-contract",
  "title": "HVE Forge Work Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "taskId",
    "status",
    "purpose",
    "scope",
    "notInScope",
    "acceptanceCriteria",
    "verificationMethods",
    "runtimeEvidenceExpectations",
    "risks",
    "recoveryPath",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contractId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["proposed", "active", "blocked", "complete", "superseded"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "scope": { "$ref": "#/$defs/stringList" },
    "notInScope": { "$ref": "#/$defs/stringList" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "blocking"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "verificationMethods": { "$ref": "#/$defs/stringList" },
    "runtimeEvidenceExpectations": { "$ref": "#/$defs/stringList" },
    "risks": { "$ref": "#/$defs/stringList" },
    "recoveryPath": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "stringList": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    }
  }
}
