{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hve-forge:schema:v1:approval",
  "title": "HVE Forge Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "runId",
    "requesterId",
    "actionClass",
    "action",
    "actionHash",
    "risk",
    "resources",
    "redactedArguments",
    "expectedEffect",
    "alternatives",
    "requestedAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "approvalId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "requesterId": { "$ref": "#/$defs/id" },
    "approverId": { "type": ["string", "null"], "maxLength": 128 },
    "actionClass": { "enum": ["workspace_write", "external_write", "destructive", "privileged", "secret_bearing"] },
    "action": { "type": "string", "minLength": 1, "maxLength": 512 },
    "actionHash": { "$ref": "#/$defs/sha256" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "redactedArguments": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "expectedEffect": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "decidedAt": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["pending", "approved", "denied", "expired", "cancelled"] },
    "decisionReason": { "type": ["string", "null"], "maxLength": 4096 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
