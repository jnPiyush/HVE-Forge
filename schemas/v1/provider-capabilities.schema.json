{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hve-forge:schema:v1:provider-capabilities",
  "title": "HVE Forge Provider Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "adapterVersion",
    "requestedModel",
    "servedModel",
    "discoveredAt",
    "contextWindowTokens",
    "maxOutputTokens",
    "streaming",
    "strictStructuredOutput",
    "parallelToolCalls",
    "promptCaching",
    "opaqueReasoningHandles",
    "sessionResume",
    "sessionFork",
    "batch",
    "unsupportedCapabilities"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "providerId": { "$ref": "#/$defs/id" },
    "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "requestedModel": { "type": "string", "minLength": 1, "maxLength": 256 },
    "servedModel": { "type": ["string", "null"], "maxLength": 256 },
    "discoveredAt": { "type": "string", "format": "date-time" },
    "contextWindowTokens": { "type": ["integer", "null"], "minimum": 1 },
    "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1 },
    "streaming": { "type": "boolean" },
    "strictStructuredOutput": { "type": "boolean" },
    "parallelToolCalls": { "type": "boolean" },
    "promptCaching": { "type": "boolean" },
    "opaqueReasoningHandles": { "type": "boolean" },
    "sessionResume": { "type": "boolean" },
    "sessionFork": { "type": "boolean" },
    "batch": { "type": "boolean" },
    "unsupportedCapabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
