{
  "name": "@hve-forge/cli",
  "version": "0.2.0",
  "description": "Deterministic cross-editor AI coding harness for VS Code, Cursor, and Claude Code.",
  "type": "module",
  "bin": {
    "hve": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./hosts": "./dist/hosts/index.js"
  },
  "files": [
    "dist/",
    "hve/",
    "schemas/",
    "config/",
    "policies/",
    "evaluation/",
    "prompts/",
    "protocols/",
    "samples/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:hosts": "node scripts/check-hosts.mjs",
    "check:layer-coverage": "node scripts/check-layer-coverage.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property",
    "test:packed-consumer": "node scripts/check-packed-consumer.mjs",
    "audit": "npm audit --audit-level=high --ignore-scripts",
    "sbom": "node scripts/new-sbom.mjs",
    "quality": "npm run check:toolchain && npm run typecheck && npm run format:check && npm run lint && npm run test:coverage && npm run check:layer-coverage && npm run build && npm run test:packed-consumer && npm run check:boundaries && npm run check:hosts && npm run check:ascii && npm run check:secrets && npm run check:supply-chain && npm run audit && npm run check:package && npm run sbom",
    "start": "node dist/cli/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
